//@version=6
indicator("Forex Setup Scanner v0.1", overlay=true, max_labels_count=200)

// ============================================================
// 1. INPUTS
// ============================================================

string groupHTF = "1. Higher-timeframe zones"
string tf1 = input.timeframe("60", "Context timeframe 1", group=groupHTF)
string tf2 = input.timeframe("240", "Context timeframe 2", group=groupHTF)

int pivotLeft = input.int(3, "Pivot left bars", minval=1, group=groupHTF)
int pivotRight = input.int(3, "Pivot confirmation bars", minval=1, group=groupHTF)
int atrLen = input.int(14, "HTF ATR length", minval=1, group=groupHTF)
float zoneAtrMult = input.float(0.15, "Zone half-width (HTF ATR)", minval=0.01, step=0.01, group=groupHTF)

string groupSetup = "2. M5 rejection setup"
float wickBodyRatio = input.float(1.5, "Minimum rejection wick / body", minval=0.1, step=0.1, group=groupSetup)
float closeLocation = input.float(0.65, "Close location threshold", minval=0.5, maxval=0.95, step=0.05, group=groupSetup)
float entryRetrace = input.float(0.50, "Entry retracement fraction", minval=0.1, maxval=0.9, step=0.05, group=groupSetup)
int cooldownBars = input.int(6, "Minimum bars between signals", minval=0, group=groupSetup)

string groupRisk = "3. Trade plan (not execution)"
int m5AtrLen = input.int(14, "M5 ATR length", minval=1, group=groupRisk)
float stopBufferAtr = input.float(0.10, "SL buffer (M5 ATR)", minval=0, step=0.05, group=groupRisk)
float rewardRisk = input.float(2.0, "Target R multiple", minval=0.5, step=0.25, group=groupRisk)

string groupDisplay = "4. Display"
bool showZones = input.bool(true, "Show H1/H4 pivot levels", group=groupDisplay)
bool showPlans = input.bool(true, "Show entry / SL / TP labels", group=groupDisplay)

// ============================================================
// 2. HTF HELPERS
// Latest confirmed pivot and ATR.
// [1] + lookahead_on uses the previous completed HTF bar.
// ============================================================

f_lastPivotLow() =>
    float p = ta.pivotlow(low, pivotLeft, pivotRight)
    ta.valuewhen(not na(p), p, 0)

f_lastPivotHigh() =>
    float p = ta.pivothigh(high, pivotLeft, pivotRight)
    ta.valuewhen(not na(p), p, 0)

// H1: use only values from a completed H1 bar.
float h1Sup = request.security(syminfo.tickerid, tf1, f_lastPivotLow()[1], lookahead=barmerge.lookahead_on)
float h1Res = request.security(syminfo.tickerid, tf1, f_lastPivotHigh()[1], lookahead=barmerge.lookahead_on)
float h1Atr = request.security(syminfo.tickerid, tf1, ta.atr(atrLen)[1], lookahead=barmerge.lookahead_on)

// H4: use only values from a completed H4 bar.
float h4Sup = request.security(syminfo.tickerid, tf2, f_lastPivotLow()[1], lookahead=barmerge.lookahead_on)
float h4Res = request.security(syminfo.tickerid, tf2, f_lastPivotHigh()[1], lookahead=barmerge.lookahead_on)
float h4Atr = request.security(syminfo.tickerid, tf2, ta.atr(atrLen)[1], lookahead=barmerge.lookahead_on)

float h1Width = h1Atr * zoneAtrMult
float h4Width = h4Atr * zoneAtrMult

// ============================================================
// 3. DRAW HTF REFERENCE LEVELS
// ============================================================

plot(showZones ? h1Sup : na, "H1 Support", color=color.new(color.green, 15), linewidth=2, style=plot.style_stepline)
plot(showZones ? h1Res : na, "H1 Resistance", color=color.new(color.red, 15), linewidth=2, style=plot.style_stepline)
plot(showZones ? h4Sup : na, "H4 Support", color=color.new(color.teal, 0), linewidth=2, style=plot.style_stepline)
plot(showZones ? h4Res : na, "H4 Resistance", color=color.new(color.orange, 0), linewidth=2, style=plot.style_stepline)

// ============================================================
// 4. SELECT A TOUCHED SUPPORT / RESISTANCE ZONE
// The signal candle must touch the zone without exceeding its
// outer edge. This is intentionally strict in the first prototype.
// ============================================================

bool touchH1Sup = not na(h1Sup) and not na(h1Width) and low <= h1Sup + h1Width and low >= h1Sup - h1Width
bool touchH4Sup = not na(h4Sup) and not na(h4Width) and low <= h4Sup + h4Width and low >= h4Sup - h4Width

bool touchH1Res = not na(h1Res) and not na(h1Width) and high >= h1Res - h1Width and high <= h1Res + h1Width
bool touchH4Res = not na(h4Res) and not na(h4Width) and high >= h4Res - h4Width and high <= h4Res + h4Width

bool useH1Sup = touchH1Sup and (not touchH4Sup or math.abs(close - h1Sup) <= math.abs(close - h4Sup))
bool useH4Sup = touchH4Sup and not useH1Sup

bool useH1Res = touchH1Res and (not touchH4Res or math.abs(close - h1Res) <= math.abs(close - h4Res))
bool useH4Res = touchH4Res and not useH1Res

float activeSupport = useH1Sup ? h1Sup : useH4Sup ? h4Sup : na
float activeResistance = useH1Res ? h1Res : useH4Res ? h4Res : na

// ============================================================
// 5. M5 CANDLE REJECTION
// ============================================================

float candleRange = high - low
float candleBody = math.abs(close - open)
float safeBody = math.max(candleBody, syminfo.mintick)
float lowerWick = math.min(open, close) - low
float upperWick = high - math.max(open, close)

float closePosition = candleRange > 0 ? (close - low) / candleRange : 0.5

bool bullishRejection = close > open and lowerWick >= safeBody * wickBodyRatio and closePosition >= closeLocation
bool bearishRejection = close < open and upperWick >= safeBody * wickBodyRatio and closePosition <= (1.0 - closeLocation)

bool longSetupRaw = not na(activeSupport) and close > activeSupport and bullishRejection
bool shortSetupRaw = not na(activeResistance) and close < activeResistance and bearishRejection

// Only emit signals when this indicator is running on M5.
bool isM5 = timeframe.isminutes and timeframe.multiplier == 5

// ============================================================
// 6. ENTRY / SL / TP PLAN
// Indicative prices only; no order is sent.
// ============================================================

float m5Atr = ta.atr(m5AtrLen)

float longEntry = low + (close - low) * entryRetrace
float longSL = low - m5Atr * stopBufferAtr
float longRisk = longEntry - longSL
float longTP = longEntry + longRisk * rewardRisk

float shortEntry = high - (high - close) * entryRetrace
float shortSL = high + m5Atr * stopBufferAtr
float shortRisk = shortSL - shortEntry
float shortTP = shortEntry - shortRisk * rewardRisk

bool validLongPlan = longRisk > syminfo.mintick and longEntry < close
bool validShortPlan = shortRisk > syminfo.mintick and shortEntry > close

// ============================================================
// 7. COOLDOWN + CLOSED-BAR SIGNALS
// ============================================================

var int lastSignalBar = na
bool cooldownOK = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars

bool longSignal = isM5 and barstate.isconfirmed and cooldownOK and longSetupRaw and validLongPlan
bool shortSignal = isM5 and barstate.isconfirmed and cooldownOK and shortSetupRaw and validShortPlan

if longSignal or shortSignal
    lastSignalBar := bar_index

// ============================================================
// 8. CHART MARKERS + TRADE PLAN LABELS
// ============================================================

plotshape(longSignal, title="Long candidate", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="LONG")
plotshape(shortSignal, title="Short candidate", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SHORT")

if showPlans and longSignal
    label.new(bar_index, low,
      "BUY LIMIT PLAN\nEntry: " + str.tostring(longEntry, format.mintick) +
      "\nSL: " + str.tostring(longSL, format.mintick) +
      "\nTP: " + str.tostring(longTP, format.mintick) +
      "\nR:R = 1:" + str.tostring(rewardRisk, "#.##"),
      style=label.style_label_up, color=color.new(color.green, 10), textcolor=color.white)

if showPlans and shortSignal
    label.new(bar_index, high,
      "SELL LIMIT PLAN\nEntry: " + str.tostring(shortEntry, format.mintick) +
      "\nSL: " + str.tostring(shortSL, format.mintick) +
      "\nTP: " + str.tostring(shortTP, format.mintick) +
      "\nR:R = 1:" + str.tostring(rewardRisk, "#.##"),
      style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white)

// ============================================================
// 9. DYNAMIC ALERTS
// Create a TradingView alert using "Any alert() function call".
// ============================================================

if longSignal
    alert("LONG CANDIDATE | " + syminfo.ticker +
      " | TF=M5 | Entry=" + str.tostring(longEntry, format.mintick) +
      " | SL=" + str.tostring(longSL, format.mintick) +
      " | TP=" + str.tostring(longTP, format.mintick) +
      " | RR=1:" + str.tostring(rewardRisk, "#.##"),
      alert.freq_once_per_bar_close)

if shortSignal
    alert("SHORT CANDIDATE | " + syminfo.ticker +
      " | TF=M5 | Entry=" + str.tostring(shortEntry, format.mintick) +
      " | SL=" + str.tostring(shortSL, format.mintick) +
      " | TP=" + str.tostring(shortTP, format.mintick) +
      " | RR=1:" + str.tostring(rewardRisk, "#.##"),
      alert.freq_once_per_bar_close)

// ============================================================
// 10. CHART TIMEFRAME STATUS
// ============================================================

var table statusTable = table.new(position.top_right, 1, 1)

if barstate.islast
    table.cell(statusTable, 0, 0,
      isM5 ? "Scanner: M5 ready" : "Switch chart to M5",
      text_color=color.white,
      bgcolor=isM5 ? color.new(color.green, 25) : color.new(color.orange, 10))
